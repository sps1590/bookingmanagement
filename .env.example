# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
#
# Everything here is free. No service in this file requires a card on file.
# See docs/FREE_STACK.md for the limits of each one and what happens when you
# reach them. There are deliberately NO SMS, WhatsApp or payment-gateway
# variables — none of those has a free tier for what we need, so none of them
# is in the product.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1) ----------------------------------------------------
# `npm run db:start` prints these for local development.
# Free tier: 500 MB database, 2 hosted projects, 50k MAU, 5 GB egress/month.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row-Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never paste into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Email (Phase 5) -------------------------------------------------------
# The primary customer channel. `log` writes to the console instead of
# sending, so a local run never emails a real patient. Keep it as the default.
# Resend free: 3,000/month, 100/day. Brevo free: 300/day.
# NOTE: 3,000/month is shared across ALL tenants, not per tenant.
NOTIFY_EMAIL_PROVIDER=log
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=

# --- Web push (Phase 5) ----------------------------------------------------
# No account, no provider, no limit — it is a browser standard.
# Generate the pair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Telegram (Phase 5, optional) ------------------------------------------
# Free and unlimited. Used for staff morning digests and owner nightly
# summaries — internal recipients, not customers.
TELEGRAM_BOT_TOKEN=

# --- Background jobs (Phase 5) ---------------------------------------------
# Shared secret pg_cron presents when invoking an Edge Function. 32+ random
# chars: `openssl rand -hex 32`
CRON_SECRET=

# --- Observability (Phase 0, optional) -------------------------------------
# Sentry free: 5k errors/month, 1 project. Leave blank to disable entirely;
# the app runs fine without it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
