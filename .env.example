# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Values marked (Phase N) are unused until that phase; leave them blank.
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1) ----------------------------------------------------
# `npx supabase start` prints these for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row-Level Security — never expose to the browser,
# never prefix with NEXT_PUBLIC_, never paste into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- SMS / WhatsApp / Email (Phase 5) --------------------------------------
# `log` writes messages to the console instead of sending — the default for
# local development so nobody texts a real patient during a test run.
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
RESEND_API_KEY=
MAIL_FROM=

# --- Payments (Phase 8) ----------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Background jobs (Phase 5) ---------------------------------------------
# Shared secret pg_cron presents when invoking an Edge Function. 32+ random
# chars: `openssl rand -hex 32`
CRON_SECRET=

# --- Observability (Phase 0, optional) -------------------------------------
# Leave blank to disable Sentry entirely; the app runs fine without it.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
