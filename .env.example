# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
#
# Everything here is free. No service in this file requires a card on file,
# with one caveat worth knowing up front: Vercel's free Hobby tier is licensed
# for non-commercial use only, so charging tenants means moving to Pro. See
# docs/FREE_STACK.md, which lists every service, its real limit, and what
# happens when you reach it.
#
# There are deliberately NO SMS, WhatsApp or payment-gateway variables — none
# of those has a free tier for what this product needs, so none of them is in
# the product. docs/DECISIONS.md D-009 and D-010 explain what replaced them.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Dashboard > Project Settings > API
# Free tier: 500 MB database, 2 projects, 50k monthly active users,
# 5 GB egress, and a pause after 7 idle days (hence the keep-alive workflow).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row-Level Security — never expose it to the browser,
# never prefix it with NEXT_PUBLIC_, never paste it into a client component.
# Four sanctioned callers only; see lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used ONLY by the command-line scripts:
#   npm run db:push     apply migrations
#   npm run db:types    regenerate lib/supabase/types.ts
#   npm run test:db     run the RLS suite
# Dashboard > Project Settings > Database > Connection string > URI.
# The application never uses this — it talks to Supabase over HTTPS.
SUPABASE_DB_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Optional: path to the Supabase CA certificate, if you want the scripts above
# to verify the server certificate strictly rather than just encrypting.
# PGSSLROOTCERT=./prod-ca-2021.crt

# --- App -------------------------------------------------------------------
# Used in booking links, calendar invites and reminder emails, so it must be
# the URL customers actually visit — not localhost, in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Email (Phase 5) -------------------------------------------------------
# The primary customer channel. `log` writes to the console instead of
# sending, so a local run never emails a real patient. Keep it as the default.
#
# Resend free: 3,000/month, 100/day. Brevo free: 300/day.
# NOTE: that 3,000 is shared across ALL tenants on the platform, not per
# tenant. Roughly 100 bookings a month across ten tenants exhausts it.
NOTIFY_EMAIL_PROVIDER=log
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=

# --- Web push (Phase 5) ----------------------------------------------------
# No account, no provider, no ceiling — it is a browser standard, and the only
# notification channel here with no limit at all.
# Generate the pair once:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Telegram (Phase 5, optional) ------------------------------------------
# Free and unlimited. Staff morning digests and owner nightly summaries —
# internal recipients, not customers.
TELEGRAM_BOT_TOKEN=

# --- Background jobs (Phase 5) ---------------------------------------------
# Shared secret the scheduler presents when invoking the reminder worker.
# 32+ random characters: `openssl rand -hex 32`
CRON_SECRET=

# --- Observability (Phase 10, optional) ------------------------------------
# Sentry free: 5k errors/month, 1 project. Leave blank to disable entirely;
# the app runs fine without it, and every PII collection category is
# explicitly switched off (docs/DECISIONS.md D-005).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# GitHub Actions secrets (not read by the app)
#
#   SUPABASE_DB_URL     keep-alive and backup workflows
#   BACKUP_PASSPHRASE   24+ random characters, stored somewhere that is NOT
#                       this repository. The nightly dump holds every tenant's
#                       patient records, and workflow artifacts on a public
#                       repository are downloadable by anyone who can see it.
# ---------------------------------------------------------------------------
